# Paper & Chalk local environment. Copy to .env (cp .env.example .env).
# Every app validates its own variables at startup and refuses to start if one is missing.
# Values below match docker-compose.yml.

# --- Docker Compose host ports (optional; defaults shown) ---------------------------------------
# PC_POSTGRES_PORT=54320
# PC_REDIS_PORT=63790
# PC_GCS_PORT=4443

# --- Postgres (used by: web, db scripts, tests) -------------------------------------------------
DATABASE_URL=postgres://pc:pc@localhost:54320/paper_chalk

# --- Redis (used by: web) ------------------------------------------------------------------------
REDIS_URL=redis://localhost:63790

# --- Google Cloud Storage (used by: web) --------------------------------------------------------
GCS_PROJECT_ID=paper-chalk-local
# Local emulator endpoint. Leave unset in staging/production to use real GCS.
GCS_API_ENDPOINT=http://localhost:4443
# Bucket names (section 2). Staging/production use globally unique names.
GCS_BUCKET_ORIGINALS=originals
GCS_BUCKET_YJS_SNAPSHOTS=yjs-snapshots
GCS_BUCKET_ASSETS=assets
GCS_BUCKET_EXPORTS=exports
GCS_BUCKET_THUMBNAILS=thumbnails

# --- Web (used by: web; inlined into the client bundle at build time) --------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ports for the Node services (optional; Cloud Run sets PORT itself) -------------------------
# SYNC_PORT=1234
# WORKERS_PORT=8081
