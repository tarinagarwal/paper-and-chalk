# Paper & Chalk environment. Copy to .env (cp .env.example .env) and fill in the blanks.
# Every app validates its own variables at startup and refuses to start if one is missing.

# --- Docker Compose host ports (optional; defaults shown) ---------------------------------------
# PC_MONGO_PORT=27027
# PC_GCS_PORT=4443

# --- MongoDB (used by: web, db scripts) ---------------------------------------------------------
# Development uses the Atlas cluster. Tests use the local container (MONGODB_TEST_URI).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/PaperDB?appName=Cluster0
MONGODB_TEST_URI=mongodb://localhost:27027/paper_chalk_test

# --- Upstash Redis (used by: web rate limiting and health) --------------------------------------
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
# "upstash" (default) or "memory" (tests and CI only; refused in production).
RATE_LIMIT_STORE=upstash
# Native Redis protocol (TLS), for the sync server's Redis extension later.
REDIS_URL=rediss://default:<upstash-token>@<your-db>.upstash.io:6379

# --- Auth (used by: web) ------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=<32+ random bytes, base64url>
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (optional in development: the Google button hides when unset).
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (used by: web) -----------------------------------------------------------------------
# "console" prints magic links to the terminal, "outbox" writes them to .data/outbox,
# "smtp" sends real email. Production requires "smtp".
EMAIL_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<you@gmail.com>
SMTP_PASSWORD=<gmail-app-password>
EMAIL_FROM="Paper & Chalk <you@gmail.com>"

# --- Sync identity (used by: web signs, sync verifies) ------------------------------------------
SYNC_JWT_SECRET=<32+ random bytes, base64url>

# --- Google Cloud Storage (used by: web) --------------------------------------------------------
GCS_PROJECT_ID=paper-chalk-local
# Local emulator endpoint. Leave unset in staging/production to use real GCS.
GCS_API_ENDPOINT=http://localhost:4443
# Bucket names (section 2). Staging/production use globally unique names.
GCS_BUCKET_ORIGINALS=originals
GCS_BUCKET_YJS_SNAPSHOTS=yjs-snapshots
GCS_BUCKET_ASSETS=assets
GCS_BUCKET_EXPORTS=exports
GCS_BUCKET_THUMBNAILS=thumbnails

# --- Web (inlined into the client bundle at build time) -----------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ports for the Node services (optional; Cloud Run sets PORT itself) -------------------------
# SYNC_PORT=1234
# WORKERS_PORT=8081
