{
  "name": "@pc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts"
  },
  "devDependencies": {
    "@pc/config": "workspace:*",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@pc/schema": "workspace:*",
    "@pc/storage": "workspace:*",
    "mongodb": "^7.6.0",
    "uuid": "14.0.2"
  }
}
