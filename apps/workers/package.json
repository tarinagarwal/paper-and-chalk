    "@pc/db": "workspace:*",
    "@pc/schema": "workspace:*",
    "@pc/storage": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "fractional-indexing": "4.0.0",
    "mongodb": "^7.6.0",
    "uuid": "14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pc/config": "workspace:*",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "volta": {
    "extends": "../../package.json"
